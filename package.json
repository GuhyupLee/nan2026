{
  "name": "nan2026-vertical-slice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fonts": "node tools/build-font-css.mjs",
    "predev": "npm run fonts",
    "dev": "vite",
    "prebuild": "npm run fonts",
    "build": "tsc --noEmit && vite build && node tools/site-build.mjs",
    "preview": "vite preview",
    "check": "tsx tools/sim-check.ts && tsx tools/determinism-check.ts && tsx tools/combat-check.ts && tsx tools/xp-gem-check.ts && tsx tools/battlefield-pickup-check.ts && tsx tools/surge-check.ts && tsx src/content/upgrade-system.test.ts && tsx src/render/adaptive-quality.test.ts && tsx tools/meta-check.ts && tsx tools/records-check.ts && tsx tools/animation-check.ts",
    "check:determinism": "tsx tools/determinism-check.ts",
    "check:combat": "tsx tools/combat-check.ts",
    "check:xp-gems": "tsx tools/xp-gem-check.ts",
    "check:battlefield-pickups": "tsx tools/battlefield-pickup-check.ts",
    "check:surges": "tsx tools/surge-check.ts",
    "check:upgrades": "tsx src/content/upgrade-system.test.ts",
    "check:records": "tsx tools/records-check.ts",
    "check:meta": "tsx tools/meta-check.ts",
    "check:animation": "tsx tools/animation-check.ts",
    "animation": "tsx tools/generate-vrma.ts",
    "art": "tsx tools/optimize-art.ts",
    "balance": "tsx tools/balance/run.ts",
    "balance:calibrate": "tsx tools/balance/calibrate.ts",
    "balance:survival": "tsx tools/survival-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-kr": "^5.3.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "pretendard": "^1.3.9",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
